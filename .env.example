# Supabase project URL and publishable/anon key are configured in js/v2/backend-config.js
# Keep service-role and email-provider secrets server-side as Supabase Edge Function secrets.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Set these with `supabase secrets set`; NEVER put them in frontend JavaScript.
SUPABASE_SERVICE_ROLE_KEY=SERVER_SIDE_ONLY
RESEND_API_KEY=SERVER_SIDE_ONLY
ALLOWED_ORIGIN=https://your-production-domain.example
